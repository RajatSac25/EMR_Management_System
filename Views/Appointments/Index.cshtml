@using EMR_Management_System.Models
@model IEnumerable<EMR_Management_System.Models.Appointment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Appointment Date</th>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.AppointmentDate)
                </td>

                <td>
                    @(item.Patient != null ? item.Patient.Name : "")
                </td>

                <td>
                    @(item.Doctor != null ? item.Doctor.Name : "")
                </td>
                <td>
                    @if (item.Status == AppointmentStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (item.Status == AppointmentStatus.Completed)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else if (item.Status == AppointmentStatus.Cancelled)
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                </td>
        </tr>
}
    </tbody>
</table>
